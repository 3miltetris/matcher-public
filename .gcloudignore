# Files excluded from the Cloud Build upload context.
# CRITICAL: keeps local secrets and service-account keys out of builds.
.git/
.gitignore
.gitignore.txt
.gcloudignore
.claude/
.streamlit/
notebooks/
keys/
*.json
__pycache__/
*.pyc
*.pyo
.env
.DS_Store
Thumbs.db

# Loose API-key drops at the repo root (Dockerfile.app does `COPY . .`,
# so an unignored key file gets baked into the published image).
# These are deliberately BROAD: on 2026-09-15 a key was dropped as
# `sam-gov-key.txt`, which matched none of the original `*_api_key*` patterns
# because it used hyphens and omitted the word "api". Match on "key" anywhere
# in the name rather than trying to predict the spelling.
*_api_key.txt
*_api_key
fathom_api_key.txt
*api_key*
*api-key*
*_key.txt
*-key.txt
*_key
*-key
*.key
*.pem
key.txt

# Same class, different vocabulary: on 2026-09-28 `OAUTH_CLIENT_ID.txt` was
# found in the upload context. It matched none of the patterns above because
# an OAuth credential is spelled with neither "key" nor "api". Verified that
# no tracked file's NAME matches these before adding them.
*oauth*
*OAUTH*
*client_id*
*CLIENT_ID*
*client-id*
*secret*
*SECRET*

# Local data drops (exported Google Sheets, scratch extracts). Dockerfile.app
# ends in `COPY . .`, so an unignored CSV at the repo root is both committed
# and baked into the published image.
*.csv
local-data/

# BW&CO playbooks + NIH knowledge base + client strategy packets. These are
# served from GCS (strategy-playbooks/), never from the image — and the
# claude_*.md packets name real clients. Dockerfile.app ends in `COPY . .`.
project-context/
