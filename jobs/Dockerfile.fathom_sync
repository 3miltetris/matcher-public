FROM python:3.11-slim

WORKDIR /app

COPY requirements.fathom_sync_job.txt .
RUN pip install --no-cache-dir -r requirements.fathom_sync_job.txt

COPY jobs/fathom_sync_job.py jobs/fathom_sync_job.py

# Shared streamlit-free modules (also imported by views/fathom_sync.py).
# pools.py resolves a meeting's company across the client AND prospect pools;
# it imports aspect_profile, which needs the two research modules and
# BucketManager — all stdlib/pandas, nothing added to requirements.
COPY src/__init__.py src/__init__.py
COPY src/modules/__init__.py src/modules/__init__.py
COPY src/modules/anthropic_utils.py src/modules/anthropic_utils.py
COPY src/modules/fathom_client.py src/modules/fathom_client.py
COPY src/modules/pools.py src/modules/pools.py
COPY src/modules/aspect_profile.py src/modules/aspect_profile.py
COPY src/modules/finance_research.py src/modules/finance_research.py
COPY src/modules/tech_research.py src/modules/tech_research.py
COPY src/modules/GoogleBucketManager/bucket_manager.py src/modules/GoogleBucketManager/bucket_manager.py

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "jobs/fathom_sync_job.py"]
