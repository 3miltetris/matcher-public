FROM python:3.11-slim

WORKDIR /app

COPY requirements.drive_sync_job.txt .
RUN pip install --no-cache-dir -r requirements.drive_sync_job.txt

COPY jobs/drive_sync_job.py jobs/drive_sync_job.py

# Shared streamlit-free modules (also imported by views/drive_sync.py)
COPY src/__init__.py src/__init__.py
COPY src/modules/__init__.py src/modules/__init__.py
COPY src/modules/anthropic_utils.py src/modules/anthropic_utils.py
COPY src/modules/doc_extract.py src/modules/doc_extract.py
COPY src/modules/drive_client.py src/modules/drive_client.py
# Generation-guarded parquet writes + run lock (Phase 1.2).
COPY src/modules/gcs_write.py src/modules/gcs_write.py
# Scheduled mode (Phase 2): scan/auto-assign, attention queue, and job_control
# for chaining client-profile-job (needs google-cloud-run in requirements).
COPY src/modules/attention.py src/modules/attention.py
COPY src/modules/drive_scan.py src/modules/drive_scan.py
COPY src/modules/folder_match.py src/modules/folder_match.py
COPY src/modules/job_control.py src/modules/job_control.py

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "jobs/drive_sync_job.py"]
