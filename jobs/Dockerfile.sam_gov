FROM python:3.11-slim

WORKDIR /app

COPY requirements.sam_gov_job.txt .
RUN pip install --no-cache-dir -r requirements.sam_gov_job.txt

COPY jobs/sam_gov_job.py jobs/sam_gov_job.py

# Shared Claude-response reader — resp.content[0].text raises IndexError on a
# refusal (empty content list), which is not the ValueError the retry handlers
# here catch. stdlib-only.
COPY src/__init__.py src/__init__.py
COPY src/modules/__init__.py src/modules/__init__.py
COPY src/modules/anthropic_utils.py src/modules/anthropic_utils.py

ENV PYTHONPATH=/app

ENTRYPOINT ["python", "jobs/sam_gov_job.py"]
